# FastAPI Configuration
API_TITLE=GeoVision Campus Security API
API_VERSION=1.0.0
API_PREFIX=/api
DEBUG=True

# Database
# SQLite (default)
DATABASE_URL=sqlite:///./gcs.db

# For PostgreSQL (uncomment and modify)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/gcs_db

# JWT Settings
SECRET_KEY=your-super-secret-key-change-in-production-geovision-campus-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Face Recognition
FACE_DB_PATH=./face_db.db
FACE_RECOGNITION_ENABLED=True
